# --- Minecraft Server ---
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=AiBot
# Leave empty to auto-detect server version.
# Supported: 1.20.1 and 26.1 (compatible with 26.1.1 - same protocol 775)
MC_VERSION=
# offline = server without authentication (cracked/local)
MC_AUTH=offline

# --- Free AI (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Optional paid AI (Hack Club AI) ---
# Enable only if you have an API key
HACKCLUB_ENABLED=false
HACKCLUB_API_KEY=
HACKCLUB_SERVER_URL=https://ai.hackclub.com/proxy/v1
HACKCLUB_MODEL=qwen/qwen3-32b

# --- Building / Schematics ---
# When true, the bot uses the Hack Club AI model to generate a 3D structure
# from a description if there is no matching local blueprint/schematic.
SCHEMATIC_GEN_ENABLED=true
# Stronger open-source model used for generating 3D building designs.
SCHEMATIC_MODEL=openai/gpt-5.4-mini
SCHEMATIC_MAX_BLOCKS=400
# Folder to place manual .schem files for the bot to load them (optional).
SCHEMATICS_DIR=./schematics

# --- Monthly budget (Hack Club AI only) ---
MONTHLY_BUDGET_EUR=3.0
EST_COST_PER_1K_TOKENS_EUR=0.00015
USD_TO_EUR_RATE=0.93

# --- General ---
LOG_LEVEL=info
BOT_LANGUAGE=en
